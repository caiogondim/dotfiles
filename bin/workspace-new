#!/usr/bin/env bun
import { $ } from "bun";

if (["--help", "-h"].includes(Bun.argv[2] ?? "")) {
  console.log("usage: workspace-new [branch]\nWith no branch, uses the current directory.");
  process.exit(0);
}

const branch = Bun.argv[2];

const room = process.env.AGENT_GOSSIP_DEFAULT_ROOM;
if (!room) {
  console.error("AGENT_GOSSIP_DEFAULT_ROOM is not set");
  process.exit(2);
}

const terminal = process.env.TERM_PROGRAM;
if (terminal !== "ghostty" && terminal !== "rex") {
  console.error(`unsupported terminal: TERM_PROGRAM=${terminal ?? ""} (need ghostty or rex)`);
  process.exit(2);
}

const worktreePath = async (branch: string) => {
  const result = await $`grove go ${branch} -p`.quiet().nothrow();
  return result.exitCode === 0 ? result.text().trim() : undefined;
};

const resolveDir = async () => {
  if (!branch) return process.cwd();
  const existing = await worktreePath(branch);
  if (existing) return existing;
  await $`grove add ${branch}`;
  return (await worktreePath(branch))!;
};

const dir = await resolveDir();

const quote = (text: string) => `'${text.replaceAll("'", `'\\''`)}'`;
const join = `/gossip-join ${room}`;
const founderPrompt =
  `${join} Then wait until 3 other peers are in the gossip. ` +
  `Then run /graph-up squad.`;
const claude = (model: string, prompt: string) =>
  `cl --model ${model} ${quote(prompt)}`;

const ghosttyScript = `
on run argv
  set dir to item 1 of argv
  tell application "Ghostty"
    set base to new surface configuration
    set initial working directory of base to dir

    set w to front window
    set origTab to selected tab of w
    set origTerminal to focused terminal of origTab

    set cfgSonnet to new surface configuration from base
    set initial input of cfgSonnet to (item 2 of argv) & linefeed
    set cfgHaiku to new surface configuration from base
    set initial input of cfgHaiku to (item 3 of argv) & linefeed
    set cfgOpus to new surface configuration from base
    set initial input of cfgOpus to (item 4 of argv) & linefeed

    set tAgents to new tab in w with configuration cfgSonnet
    set topLeft to focused terminal of tAgents
    perform action "set_tab_title:agents" on topLeft
    set topRight to split topLeft direction right with configuration cfgHaiku
    split topLeft direction down with configuration cfgHaiku
    split topRight direction down with configuration cfgOpus

    set cfgLg to new surface configuration from base
    set initial input of cfgLg to "lg" & linefeed
    new tab in w with configuration cfgLg

    set cfgVim to new surface configuration from base
    set initial input of cfgVim to "nvim" & linefeed
    new tab in w with configuration cfgVim

    select tab origTab
    focus origTerminal
  end tell
end run
`;

const openInGhostty = async (commands: string[]) => {
  await $`osascript -e ${ghosttyScript} ${dir} ${commands}`;
};

const rexBlockId = async (command: Promise<{ text(): string }>) =>
  JSON.parse((await command).text()).block_ids[0] as string;

const openInRex = async ([sonnet, haiku, opus]: string[]) => {
  const origWindow = JSON.parse(
    await $`rex window ls --json`.text(),
  ).active_window_id as string;

  const { columns, rows, cell_width_px, cell_height_px } = JSON.parse(
    await $`rex block call size`.text(),
  );
  // Hidden blocks start at 80x24. Set the size you will see, so no app redraws on first view.
  const resize = (block: string, fraction = 1) =>
    $`rex block call -b ${block} resize ${JSON.stringify({
      columns: Math.floor(columns * fraction),
      rows: Math.floor(rows * fraction),
      cell_width_px,
      cell_height_px,
    })}`.quiet();

  const topLeft = await rexBlockId(
    $`rex window new agents --cwd ${dir} --json`.quiet(),
  );
  const split = (anchor: string, direction: string) =>
    rexBlockId(
      $`rex split -b ${anchor} --split=${direction} --cwd ${dir} --json`.quiet(),
    );
  const topRight = await split(topLeft, "right");
  const bottomLeft = await split(topLeft, "below");
  const bottomRight = await split(topRight, "below");

  await Promise.all(
    [topLeft, topRight, bottomLeft, bottomRight].map((pane) => resize(pane, 0.5)),
  );

  const send = (block: string, command: string) =>
    $`rex send -b ${block} ${command + "\n"}`;
  await send(topLeft, sonnet);
  await send(topRight, haiku);
  await send(bottomLeft, haiku);
  await send(bottomRight, opus);

  for (const [label, command] of [["lg", "lg"], ["nvim", "nvim"]]) {
    const block = await rexBlockId(
      $`rex window new ${label} --cwd ${dir} --json`.quiet(),
    );
    await resize(block);
    await send(block, command);
  }

  await $`rex focus ${origWindow}`;
};

const commands = [
  claude("sonnet", founderPrompt),
  claude("haiku", join),
  claude("opus", join),
];

await (terminal === "rex" ? openInRex : openInGhostty)(commands);

console.log(dir);
